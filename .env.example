# Application
NODE_ENV=development
# Loaded as Next.js's standard PORT variable by the root development scripts.
PORT=3000
API_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_APP_BASE_URL=http://localhost:3000

# Authentication and sessions. Replace every secret in your untracked .env file.
JWT_SIGNING_SECRET=replace-with-at-least-32-random-bytes-from-a-secure-generator
JWT_ISSUER=bichocoin-api
JWT_AUDIENCE=bichocoin-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
CSRF_HMAC_SECRET=replace-with-an-independent-csrf-secret-at-least-32-bytes-long
RATE_LIMIT_HMAC_SECRET=replace-with-an-independent-rate-limit-secret-at-least-32-bytes-long
AUTH_ACCESS_COOKIE_NAME=bichocoin_access
AUTH_REFRESH_COOKIE_NAME=bichocoin_refresh
AUTH_CSRF_COOKIE_NAME=bichocoin_csrf
COOKIE_SECURE=false

# Sprint 3 mining policy. The backend is authoritative for both values.
MINING_DURATION_SECONDS=86400
MINING_REWARD_BIC=100

# Targeted authentication rate limits. Windows are expressed in seconds.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REFRESH_RATE_LIMIT_MAX=30
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_PASSWORD_RECOVERY_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_EMAIL_VERIFICATION_RATE_LIMIT_MAX=5
AUTH_EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=3600

# SMTP delivery. These defaults target the optional local Mailpit profile.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM=noreply@bichocoin.local
SMTP_USER=
SMTP_PASSWORD=

# Interactive OpenAPI documentation is opt-in and non-production only.
OPENAPI_ENABLED=false

# Local PostgreSQL. Replace the password in your untracked .env file.
POSTGRES_DB=bichocoin
POSTGRES_USER=bichocoin
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bichocoin:replace-with-a-local-only-password@localhost:5432/bichocoin?schema=public

# Integration tests opt in explicitly and must never target production data.
RUN_DATABASE_TESTS=false
AUTH_TEST_DATABASE_URL=postgresql://bichocoin:replace-with-a-local-only-password@localhost:5432/bichocoin_auth_test?schema=public
