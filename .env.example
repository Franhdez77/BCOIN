# Application
NODE_ENV=development
# Loaded as Next.js's standard PORT variable by the root development scripts.
PORT=3000
API_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Local PostgreSQL. Replace the password in your untracked .env file.
POSTGRES_DB=bichocoin
POSTGRES_USER=bichocoin
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bichocoin:replace-with-a-local-only-password@localhost:5432/bichocoin?schema=public

# Integration tests opt in explicitly and must never target production data.
RUN_DATABASE_TESTS=false
