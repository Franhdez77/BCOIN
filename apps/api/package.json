{
  "name": "@bichocoin/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "predev": "npm run prisma:generate",
    "dev": "nest start --watch",
    "prelint": "npm run prisma:generate",
    "lint": "eslint src test prisma.config.ts --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prestart": "npm run prisma:generate",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "test": "npm run prisma:generate && jest --runInBand",
    "test:database": "npm run prisma:generate && cross-env RUN_DATABASE_TESTS=true NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.29",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "globals": "17.10.0",
    "jest": "30.4.2",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
